#!/usr/bin/env sh
# Deploy the server to Fly, stamping the image with the commit it was built from so GET /health can report it.
# Falls back to "unknown" (never fails) when the sha cannot be determined, e.g. outside a git checkout.
set -eu
cd "$(dirname "$0")/.."

# t-132（S3）：多一个 staging 目标。`bin/deploy` 照旧是生产，`bin/deploy staging` 用 fly.staging.toml。
# **它此刻会拒绝**，而且拒绝的理由不是配置缺了一行，是缺一个只有 pd 能做的判断：staging 与生产共用不共用
# 同一条日志（判据 2）。共用意味着两边的事实挤在同一个牌桌上，人分不分得清、要不要分，是产品判断。
# 拒绝时把两条路都说出来——闸要人做的事，入口就得给得出材料。
config=""
if [ "${1-}" = "staging" ]; then
  shift
  config="fly.staging.toml"
  [ -f "$config" ] || { echo "bin/deploy: 找不到 $config" >&2; exit 2; }
  decision="$(sed -n 's/^# STAGING_LOG_DECISION: *//p' "$config" | head -1)"
  case "$decision" in
    shared|own) ;;
    *)
      echo "bin/deploy staging: 还不能部署——staging 与生产共用不共用同一条日志，这个决定还没落下来。" >&2
      echo "  共用：staging 指向生产那份数据，两边的事实挤在同一个牌桌上，人得自己分清哪条是哪儿的。" >&2
      echo "  各自一条：staging 挂自己的卷，互不相干，代价是 staging 上验过的东西在生产那份日志里查不到。" >&2
      echo "  归 pd（必要时它问 human）。定了之后改 $config 里的 STAGING_LOG_DECISION，并按它补上 [mounts] 与 ATEAM_URL。" >&2
      exit 2;;
  esac
fi

# t-282：**发车路上原来一步测试都不跑**——`deploy.yml` 与这个脚本都直通 `fly deploy`。
# 挡的不是眼前那条红（那条在夹具里，源码零行），挡的是「一颗真在源码里的雷，同样不会被发车拦下」。
#
# 三件写死：
# ① **默认拦住**：测试不全绿就不发车，退出码非 0。
# ② **跑不了也算拦住**：没有 pnpm、没装依赖时**不许静默放行**——一道「关着的时候看起来和开着一样」的闸
#    比没有这道闸更坏（今晚那条「投递失败按设计不出声」是同一族）。
# ③ **留一条带理由的越过**：`--skip-tests "<原因>"`，照 `--no-seam-check` 的体例。理由必须写，且会被打出来。
#    生产此刻是残的，真出事时「发不了车」比「发了一版没跑测试的车」更贵——所以这条路必须存在，但要留下名字。
skip_tests=""
saved=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --skip-tests)
      shift
      skip_tests="${1-}"
      [ -n "$skip_tests" ] || { echo "bin/deploy: --skip-tests 要一个理由，例如 --skip-tests \"生产在燃，先发车后补\"" >&2; exit 2; }
      ;;
    *) saved="$saved $1";;
  esac
  shift
done
# shellcheck disable=SC2086
set -- $saved

if [ -n "$skip_tests" ]; then
  echo "bin/deploy: 跳过测试发车。理由：$skip_tests" >&2
  echo "  （这一行是这次越过的唯一痕迹；按队里的规矩，越过的人自己在日志里记一条 note）" >&2
else
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "bin/deploy: 这里没有 pnpm，测试跑不了——不发车。" >&2
    echo "  要么装上依赖再来，要么 --skip-tests \"<原因>\" 明说你在越过它。" >&2
    exit 2
  fi
  if [ ! -d node_modules ]; then
    echo "bin/deploy: 依赖没装（没有 node_modules），测试跑不了——不发车。" >&2
    echo "  先 pnpm install，或 --skip-tests \"<原因>\"。" >&2
    exit 2
  fi
  echo "bin/deploy: 先把测试跑一遍（pnpm -r --if-present run test）" >&2
  if ! pnpm -r --no-bail --if-present run test; then
    echo "" >&2
    echo "bin/deploy: 测试没全绿——没有发车。" >&2
    echo "  修好再来，或 --skip-tests \"<原因>\" 明说你在带着红发车。" >&2
    exit 1
  fi
  echo "bin/deploy: 测试全绿，继续发车" >&2
fi

sha="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  echo "bin/deploy: working tree is dirty; the deployed sha ($sha) will not match what runs" >&2
fi
if [ -n "$config" ]; then exec fly deploy --config "$config" --build-arg "GIT_SHA=$sha" "$@"; fi
exec fly deploy --build-arg "GIT_SHA=$sha" "$@"
