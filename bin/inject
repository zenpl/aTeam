#!/usr/bin/env sh
# 「删掉被守的东西，断言必须红」——今晚定成模板的那条（pm 08:31、08:43）的一处共用执行方式。
#
# 为什么是一处共用的：17 分钟里两个人在同一个做法上各踩一个坑（pm 08:49 据此建了 t-177）——
#   · 我用 cp 备份再还原，一次失败的注入把**已经损坏的树**备份了进去，后面每轮都从坏树开始，
#     最后把 core/src/board.ts 留在损坏状态，是 git status 告诉我的、不是脚本。
#   · qa 发现我那个脚本写死了仓库路径：在 worktree 里跑不是跑不起来，是**静默地去改、build、测另一棵树**——
#     一份「可重跑的证据」把结果取自被测对象之外。
# 这两条的代价已经付过了，别再各写一份把它们重踩一遍。
#
# 用法：
#   bin/inject <文件> <原文> <替换> [-- <vitest 参数…>]
#   bin/inject packages/core/src/board.ts 'a && b' 'a' -- packages/core/test/x.test.ts
# 它做四件事：改这一处、重新 build、跑测试、还原。退出码是**注入之后测试的退出码**——
# 注入之后仍然 0（全绿），说明那条断言在它要守的东西不见了的时候什么都没说，这正是要发现的。
#
# t-350：**它说「build 没过」的时候要说出是谁红的，并且把编译器原样说的话带上。**
# 出处是 dev 22:50 自己栽的那一处：它看得见的只有「换一个注入点」，而真相是**它自己那棵树本来就是红的**——
# 于是它去指控这个工具误报，两小时后才发现，代价是两小时加一张撤掉的单（t-348）。
# 所以 build 没过时多做一步：**把注入还原回去再 build 一次**，用两次的输出把三种处境分开——
# 还原之后过了＝这次注入的责任；还原之后仍然红＝这棵树自己红；两次里一条编译器诊断都没有＝不是编译器在说话。
# 这一步只在失败那条路上跑，正常那条路（注入后测试红＝注入成功）一次 build 都不多跑。
set -e

usage() { echo "用法: bin/inject <文件> <原文> <替换> [-- <vitest 参数…>]" >&2; exit 2; }
[ $# -ge 3 ] || usage
file="$1"; from="$2"; to="$3"; shift 3
[ "${1-}" = "--" ] && shift

# 在哪棵树里被调用就改哪棵树。不写死路径：写死之后 worktree 里跑的是别人那一棵。
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

[ -f "$file" ] || { echo "找不到 $file（相对 $root）" >&2; exit 2; }
# 还原用 git，不用快照：快照记的是「此刻的样子」，可能已经是坏的；git 记的是「本该的样子」。
git rev-parse --git-dir >/dev/null 2>&1 || { echo "$root 不是 git 仓库，还原没有依据，拒绝注入" >&2; exit 2; }
git diff --quiet -- "$file" || { echo "$file 有未提交的改动：还原会把它一起丢掉。先提交或 stash。" >&2; exit 2; }

# 输出与留痕都放在 .ateam/ 下：它在 .gitignore 里，不会把这些东西算进任何人的 diff。
mkdir -p "$root/.ateam"
injected_log="$root/.ateam/inject.build.log"
base_log="$root/.ateam/inject.build.base.log"
trail="$root/.ateam/inject.abandoned.jsonl"
# 报给人的那条命令与它跑的那棵树是两样东西（pd 定稿里是两个空位）：命令在这儿，树是上面那个 $root。
build="pnpm -r build"

# t-205：**还原源码不等于还原这棵树。** 上一版只 `git checkout` 那个文件，而 `dist` 仍是**按注入过的源码**编出来的
# ——下一条不重新 build 的命令读到的是一棵源码里已经不存在的树。frontend 13:10 就据此看到过一次假的「基线 3 failed」，
# 差点当成本件的真失败报上去。这与它自己在这个脚本头上记的那个坑（「一次失败的注入把已经损坏的树备份了进去」）
# 是同一类，只是坏的不是源码是产物。
#
# 所以还原分两步：先把源码放回去，再按放回去的源码重编一次。**重编失败就把 dist 删掉**——宁可让下一条命令
# 报「没有 dist」，也不要让它读到一份对不上号的。两步都在 trap 里，所以中途失败（判据 2）走的是同一条路。
restore() {
  git checkout -- "$file"
  pnpm -r build >/dev/null 2>&1 || rm -rf packages/*/dist
}
trap restore EXIT INT TERM        # 注入中途出任何事都还原，包括 set -e 打断

# t-350 判据④：**被放弃的注入点要留痕**——文件、符号、形状、放弃的理由，各一行 JSON。
# 不留痕的话，「有多少次该红的注入被放过了」连量都量不到，而那个数正是这套做法可不可信的那个数。
mark() {
  python3 - "$file" "$from" "$trail" "$1" <<'PY'
import sys, json, re, datetime
path, old, trail, why = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
src = open(path, encoding="utf-8").read()
at = src.find(old)
sym, last = None, None
if at >= 0:
    for m in re.finditer(
        r"^[ \t]*(?:export\s+)?(?:default\s+)?(?:async\s+)?"
        r"(?:function|const|let|var|class|interface|type|enum)\s+([A-Za-z_$][\w$]*)",
        src[:at], re.M):
        last = m
    sym = last.group(1) if last else None
rec = {
    "at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "why": why,
    "file": path,
    "line": src.count("\n", 0, at) + 1 if at >= 0 else None,
    "symbol": sym,
    "shape": {"head": old[:60], "chars": len(old), "lines": old.count("\n") + 1},
}
with open(trail, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec, ensure_ascii=False) + "\n")
PY
  echo "这个注入点记在 $trail；放过去的注入点都在那里，可以数。" >&2
}

said() { grep -qE 'error TS[0-9]+' "$1"; }

# 判据①：说「没过」的时候，命令、它跑的那棵树、退出码、首条与末条原文都要出现。
# 框那一句分两档（pd 定稿第三处）：有诊断时说「编译器自己的话」，一条都没有时**不许这么说**——
# 后面跟着的其实是 pnpm 的噪声，而一句话盖两种相反的处境，就是今天栽过两次的那个形状。
say_build() {
  if said "$1"; then
    echo "跑的是 $build（在 $root），退出码 $2。下面是编译器自己的话：" >&2
    lines=$(grep -E 'error TS[0-9]+' "$1")
  else
    echo "跑的是 $build（在 $root），退出码 $2。下面是它打出来的全部内容，里面没有一条 error TS：" >&2
    lines=$(grep -v '^[[:space:]]*$' "$1" || true)
  fi
  n=$(printf '%s' "$lines" | grep -c '' || true)
  [ -n "$lines" ] || n=0
  [ "$n" -lt 1 ] || printf '%s\n' "$lines" | head -1 >&2
  [ "$n" -lt 3 ] || echo "（中间另有 $((n - 2)) 行，全文在 $1）" >&2
  [ "$n" -lt 2 ] || printf '%s\n' "$lines" | tail -1 >&2
}

# 两条路都会走到这一句，而**同一句话在这个脚本里只许出现一处**（t-187 那条对齐闸按句数核，多一处就红），
# 所以它住在一个函数里，不在两个分支里各抄一遍。
not_compiler() {
  echo "这不是编译器在说话：一条 error TS 都没有，build 这件事自己没跑成。" >&2
  echo "照下面那条命令和那个目录手跑一次——不要把这次失败算在代码上。" >&2
}

set +e
python3 - "$file" "$from" "$to" <<'PY'
import sys
path, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
src = open(path, encoding="utf-8").read()
n = src.count(old)
if n == 0:
    print(f"注入点没找到，一处都没有：{old!r}", file=sys.stderr)
    sys.exit(4)
if n > 1:
    print(f"注入点有 {n} 处，改哪一处不确定——把原文写长一点：{old!r}", file=sys.stderr)
    sys.exit(5)
open(path, "w", encoding="utf-8").write(src.replace(old, new, 1))
PY
sited=$?
set -e
[ $sited -eq 4 ] && { mark "no-site"; exit 2; }
[ $sited -eq 5 ] && { mark "many-sites"; exit 2; }
[ $sited -eq 0 ] || exit $sited

set +e
pnpm -r build > "$injected_log" 2>&1
built=$?
set -e
if [ $built -ne 0 ]; then
  # 先把注入撤掉，再 build 一次：**这一次的红白，才是「谁红的」这个问题的答案。**
  git checkout -- "$file"
  set +e
  pnpm -r build > "$base_log" 2>&1
  base=$?
  set -e
  if [ $base -ne 0 ]; then
    if said "$base_log"; then
      echo "注入之前这棵树就是红的：还原注入之后再 build 一次，仍然红——所以红的不是注入点。" >&2
      echo "先让 build 过，再来注入。" >&2
    else
      not_compiler
    fi
    say_build "$base_log" "$base"
    mark "tree-already-red"
  else
    if said "$injected_log"; then
      echo "注入之后 build 就没过——这不算「断言会红」，换一个注入点" >&2
    else
      not_compiler
    fi
    say_build "$injected_log" "$built"
    mark "site-does-not-compile"
  fi
  exit 3
fi

set +e
npx vitest run "$@"
code=$?
set -e
if [ $code -eq 0 ]; then
  echo ""
  echo "注入之后测试仍然全绿：被守的东西不见了，没有一条断言说话。"
fi
exit $code
